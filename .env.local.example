# Coalition Technologies Patient Data API
# Docs: https://documenter.getpostman.com/view/11861104/2sA35G42ve
#
# These environment variables are read ONLY on the server (src/app/api/patients/route.js).
# They are never shipped to the browser bundle — the client calls /api/patients,
# which attaches Basic Auth server-side using these values.
#
# 1. Copy this file to .env.local
# 2. Fill in the values below
# 3. Restart the dev server

API_BASE_URL=https://fedskillstest.coalitiontechnologies.workers.dev
API_USERNAME=coalition
API_PASSWORD=skills-test
